[Desktop Entry]
Name=Explor
GenericName=File Manager
GenericName[es]=Explorador de Archivos
Comment=Modern, fast and customizable file manager for Linux
Comment[es]=Explorador de archivos moderno, rápido y personalizable para Linux
Exec=explor %U
Icon=com.demonc.explor
Terminal=false
Type=Application
StartupNotify=true
Categories=System;FileTools;FileManager;Utility;Core;GTK;
MimeType=inode/directory;
Keywords=folder;manager;explore;disk;filesystem;archivos;carpetas;explorador;navegador;
StartupWMClass=com.demonc.explor
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Name[es]=Nueva Ventana
Exec=explor
